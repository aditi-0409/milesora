# Taskora Pulse - Environment Configuration Example
# Copy this file to .env or .env.local to customize your local configuration.

# Backend Spring Boot REST API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# App Environment Mode: Set to 'true' for standalone prototype/demo mode with rich state persistence,
# or set to 'false' to strictly connect to the live Java Spring Boot backend.
VITE_DEMO_MODE=true

# App Branding
VITE_APP_NAME="Taskora Pulse"
VITE_APP_TAGLINE="Plan Smarter. Collaborate Better. Deliver on Time."
